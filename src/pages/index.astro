---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/site.css";
import Demo from "../components/Demo.astro";
import demo from "../data/demo.json";
import test from "../data/test_step.json";
import armRun from "../data/runs/arm.json";
import quadRun from "../data/runs/quadruped.json";

import WaitlistForm from "../components/WaitlistForm.astro";
import { ASK, GITHUB, SITE } from "../site";

const DESC = "Lockwire checks power rails, mass, buses and sensors against your datasheets. For makers and robotics teams. See what it catches on three starter robot designs.";
const ld = [
  { "@context": "https://schema.org", "@type": "Organization", name: "Lockwire", url: SITE + "/", logo: SITE + "/favicon.svg", contactPoint: { "@type": "ContactPoint", contactType: "sales", url: SITE + "/contact" }, sameAs: [GITHUB] },
  { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "Lockwire", applicationCategory: "DeveloperApplication", operatingSystem: "macOS, Linux", description: DESC, url: SITE + "/" },
];

const plan = demo.plan;
const zKey = "Accelerometer Z";
const z = test.outside_pct[zKey];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Lockwire · From Idea to Robot</title>
  <meta name="description" content={DESC} />
  <meta property="og:title" content="Lockwire" />
  <meta property="og:description" content="From Idea to Robot. Lockwire checks the numbers in your robot against the datasheets, from the first parts list to every power-on." />
  <meta property="og:image" content="https://lockwirerobotics.com/og.png" />
  <meta property="og:url" content="https://lockwirerobotics.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Lockwire" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Lockwire" />
  <meta name="twitter:description" content={DESC} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href="https://lockwirerobotics.com/" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <header class="nav wrap">
    <a class="brand" href="/" aria-label="Lockwire home"><img src="/favicon.svg" alt="" width="28" height="28" />lockwire</a>
    <nav>
      <a href="#catches">What it catches</a>
      <a href="#pricing">Pricing</a>
      <a href="/contact">Contact</a>
      <a class="btn small dark" href="#waitlist">Join the waitlist</a>
    </nav>
  </header>

  <main>
    <section class="hero wrap">
      <h1>From Idea <em>to Robot</em></h1>
      <p class="sub">Lockwire checks the numbers in your robot against the datasheets, from the first parts list to every power-on.</p>
      <WaitlistForm />
      <p class="ctas"><a class="textlink" href={GITHUB}>or try it free on GitHub</a></p>
    </section>

    <section class="demo-wrap wrap" aria-label="Lockwire on three robots, every mode">
      <Demo ask={ASK} />
    </section>

    <section id="catches" class="wrap section">
      <h2 class="h2">What it catches</h2>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Problem</th><th>How Lockwire knows</th><th>Example</th></tr></thead>
          <tbody>
            {plan.check.violations.map((x) => (
              <tr><td>{x.quantity.endsWith("7w-mode") ? "Overloaded even in low-power mode" : "Overloaded power rail"}</td><td>Adds every part's draw on a rail and compares it with what the supply can give</td><td class="num">Drone: {x.observed.split(" (")[0]} on {x.expected.replace("<= ", "")} · <span class="badtext">{x.delta.match(/\(([^)]+)\)/)?.[1]}</span></td></tr>
            ))}
            <tr><td>Missing numbers</td><td>Names every value it could not check, so a gap is never a silent pass</td><td class="num">Drone: {plan.check.counts.not_scored} not checked, each named</td></tr>
            <tr><td>Sensors drifting after power-on</td><td>Learns each sensor's normal range from known-good runs, then flags readings outside it</td><td class="num">Public PX4 flight log, {zKey}: outside its learned normal range {z.known_good}% of the time when healthy, <span class="badtext">{z.checked}%</span> after the fault. {test.caveat} <span class="tag">Pro</span></td></tr>
            {[["Part running hot", "Arm", armRun], ["Motor over its current limit", "Quadruped", quadRun]].map(([problem, who, r]) => (
              <tr><td>{problem}</td><td>Compares each recorded reading with the part's datasheet limit</td><td class="num">{who}, {r.test.lines[0]} Preview: a simulated recording with one planted fault. <span class="tag">Pro</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="wrap section">
      <h2 class="h2">How it fits your team</h2>
      <div class="three">
        <a class="card-link" href="#demo" data-goto="design"><span class="kicker">1 · Plan</span><h3>One file for every number</h3><p>Start from your URDF or a parts list. Every value carries its source.</p><span class="go">See it in the demo ›</span></a>
        <a class="card-link" href="#demo" data-goto="check"><span class="kicker">2 · Check</span><h3>On every change</h3><p>A GitHub Action reruns the check, so a part swap can't quietly break the robot.</p><span class="go">See it in the demo ›</span></a>
        <a class="card-link" href="#demo" data-goto="run"><span class="kicker">3 · Test <span class="tag">Pro</span></span><h3>Before every power-on</h3><p>A go/no-go gate compares the powered robot with its lockfile and its known-good runs.</p><span class="go">See it in the demo ›</span></a>
      </div>
    </section>

    <section id="pricing" class="wrap section">
      <h2 class="h2">Pricing</h2>
      <div class="plans">
        <div class="plan">
          <h3>Free</h3>
          <p class="price">$0</p>
          <p class="planline">Open source. Plan and check a robot yourself.</p>
          <ul>
            <li>The check: power, mass and bus budgets</li>
            <li>Command line and Python library</li>
            <li>Desktop app for macOS (Apple silicon) and Linux</li>
            <li>AI Assistant in the app: optional, off by default, your own Claude key</li>
            <li>GitHub Action for CI</li>
          </ul>
          <pre class="start"><code>pipx install lockwire
lockwire start --example drone
lockwire check</code></pre>
          <p class="planline">Needs Python 3.12 or newer (the Python that ships with macOS is older).</p>
          <a class="btn" href={GITHUB}>Try it free on GitHub</a>
        </div>
        <div class="plan pro">
          <h3>Pro</h3>
          <p class="price">$29 <span>per user / month, billed monthly</span></p>
          <p class="planline">For teams with robots on the bench and in the field.</p>
          <ul>
            <li>Everything in Free</li>
            <li>The go/no-go gate on the powered robot</li>
            <li>Known-good baselines and drift checks</li>
            <li>ROS 2 bags and PX4 flight logs</li>
          </ul>
          <p class="planline">Opening to the waitlist first.</p>
          <a class="btn dark" href="#waitlist">Join the waitlist</a>
        </div>
        <div class="plan">
          <h3>Enterprise</h3>
          <p class="price">Custom</p>
          <p class="planline">For firms with several teams, sites or closed labs.</p>
          <ul>
            <li>Everything in Pro</li>
            <li>Licensed for several teams and sites</li>
            <li>Runs on your own machines, no cloud service</li>
            <li>Set up with you on your own robots</li>
          </ul>
          <a class="btn" href="/contact">Contact us</a>
        </div>
      </div>
    </section>

    <section class="wrap section ask">
      <h2>Send us your parts list or URDF.</h2>
      <p>Within 48 hours you get back the numbers that don&#39;t add up. Free.</p>
      <div class="ctas">
        <a class="btn dark" href={ASK}>Email us your parts list</a>
        <a class="textlink" href="/contact">or see how to reach us</a>
      </div>
    </section>
  </main>

  <footer class="wrap foot">
    <span>© 2026 Lockwire</span>
    <span><a href={GITHUB}>GitHub</a> · <a href="/contact">Contact</a></span>
    <span class="credits">Drone model: <a href={GITHUB}>lockwire</a>, Apache-2.0. Test data: <a href="https://review.px4.io/">PX4 Flight Review</a>, CC BY 4.0.</span>
    <span class="credits">We count page views and button clicks, without cookies. Questions to the Assistant are answered by Anthropic's API.</span>
  </footer>

  <p class="mailnote" id="mailnote" role="status" hidden>Your mail app should open. Nothing happened? Our address is on the <a href="/contact">Contact page</a>.</p>

  <script>
    import "../scripts/hits.js";
    // A note after any email link in case no mail app opens.
    const note = document.getElementById("mailnote");
    let timer;
    document.addEventListener("click", (e) => {
      if (e.target.closest?.('a[href^="mailto:"]')) {
        note.hidden = false;
        clearTimeout(timer);
        timer = setTimeout(() => (note.hidden = true), 20000);
      }
    });
  </script>

</body>
</html>
