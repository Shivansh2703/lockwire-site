---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/site.css";
import { ASK, EMAIL, GITHUB } from "../site";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Contact · Lockwire</title>
  <meta name="description" content="Write to Lockwire about Pro, Enterprise or a free 48-hour check of your robot." />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href="https://lockwirerobotics.com/contact" />
</head>
<body>
  <header class="nav wrap">
    <a class="brand" href="/" aria-label="Lockwire home"><img src="/favicon.svg" alt="" width="28" height="28" />lockwire</a>
    <nav>
      <a href="/#pricing">Pricing</a>
      <a class="btn small dark" href="/#waitlist">Join the waitlist</a>
    </nav>
  </header>

  <main class="wrap section contact">
    <h1 class="h2">Contact</h1>
    <p class="planline">Questions about Pro or Enterprise, or a robot you want checked.</p>
    <div class="contact-cards">
      <div class="plan">
        <span class="kicker">Email</span>
        <a class="contact-mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <button class="btn" type="button" data-copy={EMAIL}>Copy address</button>
      </div>
      <div class="plan">
        <span class="kicker">Free 48-hour check</span>
        <p>Send your URDF or parts list. Within 48 hours you get back the numbers that don&#39;t add up.</p>
        <a class="btn dark" href={ASK}>Send a parts list or URDF</a>
      </div>
    </div>
  </main>

  <footer class="wrap foot">
    <div class="foot-row">
      <span>© 2026 Lockwire</span>
      <span class="foot-links"><a href={GITHUB}>GitHub</a><a href="/">Home</a></span>
    </div>
  </footer>

  <script>
    import "../scripts/hits.js";
    document.addEventListener("click", (e) => {
      const b = (e.target as Element).closest?.<HTMLElement>("[data-copy]");
      if (b) navigator.clipboard?.writeText(b.dataset.copy!).then(() => (b.textContent = "Copied"), () => {});
    });
  </script>
</body>
</html>
