---
import "../styles/demo.css";
import drone from "../data/robots/drone.json";
import arm from "../data/robots/arm.json";
import quadruped from "../data/robots/quadruped.json";

// First paint is Drone + Check, rendered here so it works with JavaScript off. demo.js takes over from there.
const pickers = [drone, arm, quadruped].map((r) => ({ id: r.id, title: r.title }));
const MODES = ["design", "declare", "check", "plan", "test", "run", "docs"];
const label = (m: string) => m[0].toUpperCase() + m.slice(1);
const robot = drone;
const mode = robot.modes.check;
const tone = mode.verdict === "NO-GO" ? "bad" : mode.verdict === "GO" ? "go" : "muted";
const hi = new Set(mode.highlight);
const assistantUrl = import.meta.env.PUBLIC_ASSISTANT_URL; // unset: the Ask box is not rendered
---
<section class="demo wrap" id="demo" aria-label="Interactive demo" data-demo data-robot="drone" data-mode="check">
  <div class="demo-bar">
    <div class="demo-pick" role="group" aria-label="Robot">
      {pickers.map((p) => <button type="button" data-robot-btn={p.id} aria-pressed={String(p.id === "drone")}>{p.title}</button>)}
    </div>
  </div>

  <div class="demo-grid">
    <div class="demo-view" data-view>
      <img src="/app.png" alt="The Lockwire app showing a drone with a failed check" width="1200" height="750" decoding="async" />
      <canvas data-canvas aria-label="3D model of the robot. Drag to turn it, click a part for its facts." tabindex="-1"></canvas>
      <div class="demo-tip" data-tip hidden></div>
      <div class="demo-card" data-card role="region" aria-label="Part facts" hidden></div>
      {robot.catch && (
        <div class="demo-catch" data-catch>
          <span class="demo-verdict bad">NO-GO</span>
          <strong data-catch-title>{robot.catch.title}</strong>
          <span class="demo-catch-n"><b data-catch-needed>{robot.catch.needed}</b> needed · <span data-catch-avail>{robot.catch.available}</span> available · <span class="over" data-catch-over>{robot.catch.over}</span></span>
        </div>
      )}
      <p class="demo-hint" data-hint>Drag to turn. Click a part.</p>
      <nav class="demo-modes" aria-label="Modes">
        <button type="button" class="demo-step" data-step="-1" aria-label="Previous mode">&lsaquo;</button>
        <div class="demo-tabs" role="tablist" aria-label="Mode">
          {MODES.map((m) => (
            <button type="button" role="tab" id={`demo-tab-${m}`} data-mode-btn={m} aria-selected={String(m === "check")} aria-controls="demo-panel" tabindex={m === "check" ? 0 : -1}>{label(m)}{(m === "test" || m === "run") && <span class="demo-pro">Pro</span>}</button>
          ))}
        </div>
        <button type="button" class="demo-step" data-step="1" aria-label="Next mode">&rsaquo;</button>
      </nav>
    </div>

    <div class:list={["demo-side", { "has-ask": !!assistantUrl }]}>
    <div class="demo-panel" id="demo-panel" role="tabpanel" aria-labelledby="demo-tab-check" data-panel data-tone={tone}>
      <div class="demo-verdict-row">
        {mode.verdict && !robot.catch && <span class={`demo-verdict ${tone}`}>{mode.verdict}</span>}
      </div>
      <h3 class="demo-headline">{mode.headline}</h3>
      <details class="demo-more">
        <summary>Details</summary>
        <ul class="demo-lines">{mode.lines.map((l) => <li>{l}</li>)}</ul>
        <p class="demo-src"><code>{mode.source}</code></p>
        <ul class="demo-parts">
          {robot.parts.map((p) => (
            <li><button type="button" data-part={p.id} aria-pressed="false" class={hi.has(p.id) ? "hl" : ""}>{p.name}</button></li>
          ))}
        </ul>
      </details>
    </div>
    {assistantUrl && (
      <form class="demo-ask" data-ask data-url={assistantUrl} aria-label="Ask about this robot">
        <label class="demo-ask-title" for="demo-ask-q">Ask the Lockwire Assistant</label>
        <div class="demo-ask-chips">
          <button type="button" data-q="Why is this NO-GO?">Why is this NO-GO?</button>
          <button type="button" data-q="How would I fix it?">How would I fix it?</button>
        </div>
        <div class="demo-ask-row">
          <input id="demo-ask-q" name="q" type="text" maxlength="500" autocomplete="off" placeholder="Ask about this robot" />
          <button type="submit">Send</button>
        </div>
        <p class="demo-ask-out" data-ask-out role="status" aria-live="polite"></p>
        <p class="demo-ask-note">A preview of the AI Assistant built into the Lockwire app, where it also runs checks and drafts fixes you approve. Questions go to Anthropic's API to be answered, so don't paste anything confidential. 30 a day.</p>
      </form>
    )}
    </div>
  </div>
  <p class="demo-credit">{robot.title}: based on {robot.based_on} ({robot.licence}{robot.licence_files.map((f) => <>, <a href={f}>{f.endsWith("NOTICE.txt") ? "notice" : "licence"}</a></>)}). Numbers come from <code>{robot.source}</code>.</p>
</section>

<script>
  import "../scripts/demo.js";
</script>
